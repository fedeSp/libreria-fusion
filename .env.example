# Copiar a .env y completar. El .env NO se commitea.

# ---- Postgres (lo levanta docker-compose) ----
POSTGRES_USER=fusion
POSTGRES_PASSWORD=fusion_dev
POSTGRES_DB=fusion
POSTGRES_PORT=5432

# ---- App ----
WEB_PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Para correr Prisma desde Windows (fuera de Docker) apuntá a localhost.
# Dentro de docker-compose el host es "db" y lo inyecta el compose.
DATABASE_URL=postgresql://fusion:fusion_dev@localhost:5432/fusion?schema=public

# ---- Mercado Pago ----
# Credenciales de PRUEBA mientras desarrollamos:
# https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ---- Admin ----
# Cambiar por una cadena larga y aleatoria antes de salir a producción.
ADMIN_SESSION_SECRET=dev_secret_cambiar_en_produccion

# ---- Email (aviso al admin cuando entra una compra) ----
# Si usás Gmail: host smtp.gmail.com, port 587, y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# A quién le llega el aviso. Si vacío, usa el email de la tienda (store.email).
ADMIN_NOTIFY_EMAIL=
